// Datamodel: drie tabellen. Een nieuwe itemsoort toevoegen mag nooit een
// migratie of codewijziging vereisen, daarom staan velddefinities en
// veldwaarden als JSON-tekst in 1 kolom, niet als aparte kolommen

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

/// Een itemsoort die de gebruiker zelf kan invullen/maken, bv: "persoon", "boek", "plek"
model ItemType {
  id   Int     @id @default(autoincrement())
  name String  @unique
  icon String?

  /// JSON-array met velddefinities:
  /// [{ "name": "verjaardag", "type": "date", "required": false }]
  fieldDefinitions String @default("[]")

  items Item[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("soorten")
}

/// Alles wat de gebruiker vastlegt: een notitie, een persoon, een boek.
model Item {
  id     Int      @id @default(autoincrement())
  typeId Int
  type   ItemType @relation(fields: [typeId], references: [id], onDelete: Cascade)

  title String
  body  String   @default("")
  date  DateTime @default(now())

  /// JSON-object met de ingevulde waarden: { "verjaardag": "1998-04-12" }
  fieldValues String @default("{}")

  /// Verbindingen waar dit item het vertrekpunt is, en waar het het doel is.
  connectionsFrom Connection[] @relation("ConnectionFrom")
  connectionsTo   Connection[] @relation("ConnectionTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([typeId])
  @@map("items")
}

/// Connection tussen twee items. Eén keer opgeslagen, in beide richtingen
/// leesbaar: notitie A -> persoon B levert de notitie ook op de pagina van B.
model Connection {
  id Int @id @default(autoincrement())

  fromItemId Int
  toItemId   Int
  label      String?

  fromItem Item @relation("ConnectionFrom", fields: [fromItemId], references: [id], onDelete: Cascade)
  toItem   Item @relation("ConnectionTo", fields: [toItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([fromItemId, toItemId])
  @@index([toItemId])
  @@map("verbindingen")
}